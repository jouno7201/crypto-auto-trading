# 코인 자동매매 시스템 환경변수
# 이 파일을 .env로 복사 후 실제 값을 입력하세요

# 서버
PORT=3008
LOG_LEVEL=info

# ===== 보안 설정 =====

# 인증 활성화 (false로 설정하면 개발 시 인증 비활성화)
AUTH_ENABLED=true

# API 토큰 (Bearer 토큰으로 사용, JWT 발급에도 사용)
API_TOKEN=your_secure_api_token_here

# JWT 시크릿 (토큰 서명용, 충분히 긴 랜덤 문자열 사용)
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES=24h

# CORS 허용 Origin (쉼표 구분, 미설정 시 localhost만 허용)
# CORS_ORIGINS=http://localhost:3008,https://your-domain.com

# Rate Limiting (분당 요청 수)
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_HEAVY=5

# 거래소 API - Upbit
UPBIT_ACCESS_KEY=your_upbit_access_key
UPBIT_SECRET_KEY=your_upbit_secret_key

# 거래소 API - Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key

# 매매 모드: paper(페이퍼) / live(실거래)
TRADING_MODE=paper

# Discord 웹훅 알림
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# 봇 설정
BOT_MARKET=KRW-BTC
BOT_STRATEGY=ensemble
BOT_UNIT=60
BOT_INTERVAL=60000
BOT_CAPITAL=1000000
